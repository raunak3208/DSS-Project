# ---------- LLM (free tier). Copy to .env:  cp .env.example .env ----------
# Reasoning engine for the agent. With no key the agent uses its built-in rule-based reasoner (the demo still works).
LLM_PROVIDER=mistral              # mistral | ollama | openai_compat | heuristic
MISTRAL_API_KEY=                  # free key from https://console.mistral.ai  (leave empty to run without an LLM)
LLM_MODEL=                        # default: mistral-small-latest (mistral) / llama3.2 (ollama)
LLM_BASE_URL=                     # override for ollama/openai_compat. Ollama on the host: http://host.docker.internal:11434/v1
LLM_API_KEY=                      # only for openai_compat servers that need a key
LLM_TIMEOUT_S=60

# ---------- Remediation policy (safety gate) ----------
REMEDIATION_MODE=auto             # auto = low-risk actions run by themselves | approve_all = a human approves everything
AUTO_MAX_RISK=2                   # 1 low (restart pod, scale up) | 2 medium (restart service) | 3 high (rollback)
MIN_CONFIDENCE=0.7                # below this the agent must ask a human
COOLDOWN_S=60                     # same action on same target is denied inside this window
MAX_AUTO_PER_10MIN=6
MAX_REPLICAS=4
MAX_ITERATIONS=3                  # investigate -> fix -> verify attempts before escalating to a human
APPROVAL_TIMEOUT_S=300            # unanswered approval requests escalate after this

# ---------- Loop timing ----------
DEBOUNCE_S=6
VERIFY_SETTLE_S=6
VERIFY_POLL_S=3
VERIFY_TIMEOUT_S=45

# ---------- Demo traffic / infrastructure ----------
LOAD_RPS=6
MEM_LIMIT_MB=256
EXECUTOR_BACKEND=docker           # docker (Compose) | k8s (in-cluster) | sim (no side effects)
GRAFANA_ADMIN_PASSWORD=admin
